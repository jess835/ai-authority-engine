# --- Transcription + generation ---
OPENAI_API_KEY=              # Whisper (transcription) + generation
ASSEMBLYAI_API_KEY=          # transcript fallback (optional but recommended for long audio)
OPENAI_MODEL=gpt-4o-mini     # generation model; bump to gpt-4o for higher quality
LLM_PROVIDER=openai          # generation provider (openai; abstracted for future Claude)

# --- Knowledge base (Notion) ---
NOTION_API_KEY=              # internal integration secret (starts with "ntn_" or "secret_")
NOTION_PARENT_PAGE_ID=       # page the per-client databases get created under (used by setup:notion)
SOURCES_DB_ID=               # filled in after running `npm run setup:notion`
ASSETS_DB_ID=                # filled in after running `npm run setup:notion`

# --- Pilot client feed ---
PILOT_FEED_URL=https://anchor.fm/s/106844750/podcast/rss   # E-Forge With Cory Long
PILOT_CLIENT_NAME=Cory Long

# --- Distribution (Week 3) ---
# Anything you leave blank below simply falls back to the paste pack (`npm run handoff`).
# Fill in a platform's credentials and `npm run publish` auto-posts to it via its own API.

# Website (WordPress): the robust one. Create an Application Password in WP under
# Users -> Profile -> Application Passwords.
WORDPRESS_URL=               # e.g. https://clientsite.com
WORDPRESS_USER=              # a WP username with author rights
WORDPRESS_APP_PASSWORD=      # the generated application password

# Bing indexing (direct API). Submit live page URLs where AI answer engines look.
BING_WEBMASTER_API_KEY=      # from Bing Webmaster Tools -> Settings -> API access
BING_SITE_URL=               # your verified site, e.g. https://clientsite.com

# X (Twitter): OAuth2 user token with tweet.write scope (requires a paid X API tier).
X_ACCESS_TOKEN=

# Facebook Page (Graph API): needs a Meta app + Page access token (app review to post).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# LinkedIn member posts: needs a LinkedIn app with w_member_social + app approval.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=         # e.g. urn:li:person:XXXXXXXX

# Note: Instagram (no text-only API), LinkedIn/Medium/Substack articles have no posting
# API for anyone; those stay in the paste pack, or use the browser-posting flow in the SOP.

# --- Later weeks (leave blank for now) ---
APIFY_TOKEN=
YOUTUBE_API_KEY=
SLACK_BOT_TOKEN=
