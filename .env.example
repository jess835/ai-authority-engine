# --- Transcription + generation ---
OPENAI_API_KEY=              # Whisper (transcription) + generation
ASSEMBLYAI_API_KEY=          # transcript fallback (optional but recommended for long audio)
OPENAI_MODEL=gpt-4o-mini     # generation model; bump to gpt-4o for higher quality
LLM_PROVIDER=openai          # generation provider (openai; abstracted for future Claude)

# --- Knowledge base (Notion) ---
NOTION_API_KEY=              # internal integration secret (starts with "ntn_" or "secret_")
NOTION_PARENT_PAGE_ID=       # page the per-client databases get created under (used by setup:notion)
SOURCES_DB_ID=               # filled in after running `npm run setup:notion`
ASSETS_DB_ID=                # filled in after running `npm run setup:notion`

# --- Pilot client feed ---
PILOT_FEED_URL=https://anchor.fm/s/106844750/podcast/rss   # E-Forge With Cory Long
PILOT_CLIENT_NAME=Cory Long

# --- Later weeks (leave blank for now) ---
APIFY_TOKEN=
YOUTUBE_API_KEY=
SLACK_BOT_TOKEN=
BING_WEBMASTER_API_KEY=
